# OpenPrintHQ single-tenant stack (docker-compose.single.yml). Copy to .env.
# Generate each secret with: openssl rand -hex 32
OPHQ_DB_PASSWORD=
SESSION_SECRET=
# The reverse proxy adds this as X-ophq-gateway on every request, so the
# identity headers from Authentik are trusted only when they came through it.
OPHQ_GATEWAY_SECRET=
# The address people use, e.g. https://openprinthq.example.org
OPHQ_PUBLIC_URL=
TZ=UTC
