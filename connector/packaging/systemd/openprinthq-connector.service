# OpenPrintHQ local connector — systemd unit (Linux)
#
# Install:
#   sudo useradd -r -s /usr/sbin/nologin ophq        # optional service user
#   sudo mkdir -p /opt/openprinthq-connector
#   sudo cp -r src package.json /opt/openprinthq-connector/
#   sudo cp packaging/systemd/openprinthq-connector.service /etc/systemd/system/
#   sudo cp .env.example /etc/openprinthq-connector.env   # then edit it
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now openprinthq-connector
#   journalctl -u openprinthq-connector -f
[Unit]
Description=OpenPrintHQ local connector
Documentation=https://openprinthq.example.org
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Requires Node.js >= 20 on PATH.
ExecStart=/usr/bin/node /opt/openprinthq-connector/src/agent.js
EnvironmentFile=/etc/openprinthq-connector.env
Restart=always
RestartSec=5
# Hardening (optional; the agent needs only outbound network + LAN access).
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
