# OpenPrintHQ local connector — configuration
# Copy to .env (Docker) or export these in your service unit.

# Required — your OpenPrintHQ base URL (the cloud instance).
OPHQ_CONTROL_URL=https://openprinthq.example.org

# Required — create this in the web UI: Settings → Connectors → New connector.
OPHQ_CONNECTOR_TOKEN=

# Optional — a friendly name shown in the UI.
OPHQ_CONNECTOR_NAME=home-lab

# Optional — which LAN hosts the connector may reach. Comma-separated.
#   "private" = all RFC1918 ranges (10/8, 172.16/12, 192.168/16) + loopback.
#   You can also list exact IPs/CIDRs/wildcard domains, e.g.:
#   OPHQ_ALLOW=10.10.10.0/24,printer.lan,*.local
OPHQ_ALLOW=private

# Optional — allowed destination ports (printer APIs / cameras). "*" = any.
OPHQ_ALLOW_PORTS=80,443,7125,8080,8081,8888,3000,1883,8883,990,21

# REQUIRED — command signing.
#
# The connector verifies that every command it receives is signed by your
# control-plane's private key, and rejects anything else. Without this, anything
# that can reach this process can drive it against your LAN.
#
# You do not need to copy a key by hand. Point this at a writable, PERSISTENT
# path and the connector fetches and pins the key on first run, printing its
# fingerprint. Compare that fingerprint against Settings → Connectors in the web
# UI to confirm the pin.
#
# The path must survive restarts. If it does not, the key re-pins on every boot
# and pinning protects nothing.
OPHQ_SIGNING_PUBKEY_FILE=/data/ophq-signing.pub.pem

# Alternative — paste the PEM inline instead. Treated as a deliberate pin: the
# connector will not fetch or overwrite it.
# OPHQ_SIGNING_PUBKEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# DANGEROUS — run without verifying signatures. The connector refuses to start
# with no pinned key unless you set this, and warns every 15 minutes while it
# runs. Supported for LAN testing only. Do not set this on anything reachable
# from outside your network.
# OPHQ_ALLOW_UNSIGNED=1

# Recommended — mutual auth. Point this at a writable file; the connector keeps
# its own RSA key there (created on first run). Print the PUBLIC key to register
# with:  node src/agent.js --pubkey   (paste it into Settings → Connectors → Key).
# With Docker this lives on the mounted ./data volume by default.
OPHQ_CLIENT_KEY_FILE=/data/connector-key.pem

# Optional — keep-alive: reconnect if no data (the server pings ~every 20s)
# arrives within this many ms. Catches silent drop-outs / NAT timeouts.
OPHQ_STREAM_TIMEOUT_MS=60000
