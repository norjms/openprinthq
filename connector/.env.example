# OpenPrintHQ local connector — configuration
# Copy to .env (Docker) or export these in your service unit.

# Required — your OpenPrintHQ base URL (the cloud instance).
OPHQ_CONTROL_URL=https://openprinthq.example.org

# Required — create this in the web UI: Settings → Connectors → New connector.
OPHQ_CONNECTOR_TOKEN=

# Optional — a friendly name shown in the UI.
OPHQ_CONNECTOR_NAME=home-lab

# Optional — which LAN hosts the connector may reach. Comma-separated.
#   "private" = all RFC1918 ranges (10/8, 172.16/12, 192.168/16) + loopback.
#   You can also list exact IPs/CIDRs/wildcard domains, e.g.:
#   OPHQ_ALLOW=10.10.10.0/24,printer.lan,*.local
OPHQ_ALLOW=private

# Optional — allowed destination ports (printer APIs / cameras). "*" = any.
OPHQ_ALLOW_PORTS=80,443,7125,8080,8081,8888,3000,1883,8883,990,21

# Recommended — the RSA public key from Settings → Connectors → Signing key.
# When set, the connector verifies that every command it receives is signed by
# your control-plane's private key, and rejects anything else. Paste the PEM
# inline (use \n or a real multi-line value) OR point to a file with
# OPHQ_SIGNING_PUBKEY_FILE=/path/to/ophq-signing.pub.pem
# OPHQ_SIGNING_PUBKEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
