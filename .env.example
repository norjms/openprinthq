# OpenPrintHQ control-plane environment (copy to .env and fill in)
# SPDX-License-Identifier: AGPL-3.0-or-later

# Control-plane database (accounts + instance registry)
DATABASE_URL=postgresql://ophq_app:CHANGEME@10.10.10.254:5432/ophq_control

# Session signing secret (generate: openssl rand -hex 32)
SESSION_SECRET=CHANGEME

# Postgres server used for per-tenant databases (usually same server)
OPHQ_PG_HOST=10.10.10.254
OPHQ_PG_PORT=5432
OPHQ_PG_USER=ophq_app
OPHQ_PG_PASS=CHANGEME

# Per-tenant engine image (leave blank until the engine image is published;
# provisioning still creates the tenant DB and registers the instance).
OPHQ_ENGINE_IMAGE=

# Base port for per-tenant engine containers (instance id is added to this)
OPHQ_BASE_PORT=39000

# Authentik OIDC (leave blank to use dev sign-in)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
